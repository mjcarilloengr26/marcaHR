PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Postgres connection string (Supabase). Use the Session pooler connection string
# from the project's Database Settings, not the direct connection (IPv6-only) or the
# transaction pooler (doesn't suit a long-running Express server). See README.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Email notifications (leave requests, expense reports, task assignments, performance reviews).
# Leave these blank to disable — emails are skipped (and logged to the console) if unset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASS=a 16-character Gmail "App Password" (not your regular password — see README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional fallback office location for GPS attendance geofencing, used only for
# employees with no location assigned via the in-app Locations page. When set,
# clock-in/out is rejected outside OFFICE_RADIUS_METERS of this point (default
# 1000m / 1km). Leave all blank to disable geofencing for unassigned employees.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_METERS=1000

# ── First boot only ─────────────────────────────────────────────────────────
# These are read once, when the database has no users at all. After that they
# are ignored, so leaving them set does nothing.

# The administrator created on a fresh install. Leave the password blank and a
# strong one is generated and printed to the log once — copy it then.
SETUP_ADMIN_EMAIL=admin@example.com
SETUP_ADMIN_PASSWORD=

# Set to true ONLY for demonstrations. It fills the database with sample
# employees, sales records and expense reports, including accounts whose
# passwords are published in the documentation. Never enable it on a system
# that will hold real payroll.
SEED_DEMO_DATA=false

# ── Front end ───────────────────────────────────────────────────────────────
# Which sites may call this API, comma-separated. Leave unset and any website
# can call it — the server warns at boot when that happens.
CORS_ORIGIN=
