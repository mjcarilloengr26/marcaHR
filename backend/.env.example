PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Email notifications (leave requests, expense reports, task assignments, performance reviews).
# Leave these blank to disable — emails are skipped (and logged to the console) if unset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASS=a 16-character Gmail "App Password" (not your regular password — see README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional office location for GPS attendance. When set, each clock-in/out records
# the employee's distance from this point (shown to HR on the Attendance page).
# Leave blank to just record raw coordinates without a distance.
OFFICE_LAT=
OFFICE_LNG=
