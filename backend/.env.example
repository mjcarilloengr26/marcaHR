PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Postgres connection string (Supabase). Use the Session pooler connection string
# from the project's Database Settings, not the direct connection (IPv6-only) or the
# transaction pooler (doesn't suit a long-running Express server). See README.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Email notifications (leave requests, expense reports, task assignments, performance reviews).
# Leave these blank to disable — emails are skipped (and logged to the console) if unset.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASS=a 16-character Gmail "App Password" (not your regular password — see README).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional fallback office location for GPS attendance geofencing, used only for
# employees with no location assigned via the in-app Locations page. When set,
# clock-in/out is rejected outside OFFICE_RADIUS_METERS of this point (default
# 1000m / 1km). Leave all blank to disable geofencing for unassigned employees.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_METERS=1000
